@echo off
rem 隐式启动：本脚本先以隐藏窗口自我重启（trampoline），就绪后弹 Windows 通知
if "%~1"=="hidden" goto run
powershell -NoProfile -WindowStyle Hidden -Command "Start-Process -FilePath '%~f0' -ArgumentList 'hidden' -WindowStyle Hidden" >nul 2>nul
exit /b 0

:run
cd /d "%~dp0"

rem ===== 定位 Node（含 fnm 默认别名兜底） =====
set "NODE_EXE="
for /f "delims=" %%i in ('where node 2^>nul') do (if not defined NODE_EXE set "NODE_EXE=%%i")
if not defined NODE_EXE if exist "%APPDATA%\fnm\aliases\default\node.exe" set "NODE_EXE=%APPDATA%\fnm\aliases\default\node.exe"
if not defined NODE_EXE (
  powershell -NoProfile -EncodedCommand  >nul 2>nul
  exit /b 1
)

netstat -ano | findstr /r /c:":3000 .*LISTENING" >nul 2>nul
if not errorlevel 1 (
  powershell -NoProfile -EncodedCommand  >nul 2>nul
  exit /b 0
)

if not exist node_modules call npm install --no-audit --no-fund >nul 2>nul

rem dist/ 不入库：缺失则构建前端，构建失败直接走"启动失败"通知（preflight 不依赖 dist）
if not exist dist\index.html (
  call npm run build >nul 2>nul
  if not exist dist\index.html exit /b 1
)

rem ===== 尽力拉起判题沙箱（离线只影响代码/指令类判分，不阻塞启动） =====
wsl -d Ubuntu -u root -e bash -lc "systemctl start llmtest-judge-proxy >/dev/null 2>&1; docker start llm-test-judge >/dev/null 2>&1; true" >nul 2>nul

rem 隐藏启动 node 并记录 PID，供停止脚本使用
powershell -NoProfile -Command "$p = Start-Process -FilePath '%NODE_EXE%' -ArgumentList 'server.js' -WorkingDirectory '%CD%' -WindowStyle Hidden -PassThru; Set-Content -Path 'data\service.pid' -Value $p.Id -Encoding Ascii" >nul 2>nul

set /a TRIES=0
:wait
timeout /t 1 /nobreak >nul
curl -sf --max-time 2 http://127.0.0.1:3000/api/preflight >nul 2>nul
if not errorlevel 1 (
  powershell -NoProfile -EncodedCommand  >nul 2>nul
  exit /b 0
)
set /a TRIES+=1
if %TRIES% lss 20 goto wait
powershell -NoProfile -EncodedCommand  >nul 2>nul
exit /b 1
